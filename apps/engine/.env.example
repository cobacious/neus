# Feed Ingestion Configuration
# Optional: comma-separated URLs to override default RSS feeds
# FEED_URLS=http://feeds.bbci.co.uk/news/rss.xml,https://www.theguardian.com/uk/rss

# SQLite Database (for local engine development)
DATABASE_URL=file:./dev.db

# Ingestion Settings
# Maximum articles to process per run (0 = unlimited)
MAX_ARTICLES=0

# AI Provider Credentials
# Set GEMINI_API_KEY to use Google Gemini for embeddings (gemini-embedding-2) and summaries (gemini-flash-latest)
GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Set OPENAI_API_KEY if using OpenAI
OPENAI_API_KEY=

# Summary Model Selection
# Options: gemini-flash-latest (free/fast), gemini-2.5-flash (better quality), gpt-4o-mini
SUMMARY_MODEL=gemini-flash-latest

# Token Limits
# Optional: max token budget per run (0 = unlimited)
TOKEN_LIMIT=0
