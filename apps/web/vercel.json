{
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/:slug((?!api/|assets/|favicon\\.svg|og-image\\.png|apple-touch-icon\\.png|robots\\.txt|feed\\.xml|rss\\.xml|sitemap\\.xml).*)",
      "destination": "/api/og-preview?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
