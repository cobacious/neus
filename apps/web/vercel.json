{
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/:slug((?!api/|assets/|favicon\\.svg|og-image\\.png|apple-touch-icon\\.png|robots\\.txt).*)",
      "destination": "/api/og-preview?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
