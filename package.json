{
  "name": "@neus/neus",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @neus/db --filter @neus/api build",
    "build:web": "pnpm --filter @neus/db --filter @neus/web build",
    "build:admin": "pnpm --filter @neus/admin build",
    "start:api": "pnpm --filter @neus/api start",
    "start:web": "pnpm --filter @neus/web start",
    "dev": "pnpm --filter @neus/api --filter @neus/web dev",
    "dev:admin": "pnpm --filter @neus/admin dev",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @neus/db exec prisma generate",
    "db:migrate": "pnpm --filter @neus/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @neus/db exec prisma db seed",
    "pipeline": "pnpm --filter @neus/engine pipeline",
    "substack:draft": "pnpm --filter @neus/engine substack:draft",
    "bluesky:post": "pnpm --filter @neus/engine bluesky:post"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15"
  }
}
